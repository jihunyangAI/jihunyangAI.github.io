---
import Base from "../../layouts/Base.astro";
import { collectTags, getPosts } from "../../lib/posts";
import { url } from "../../lib/url";

const tags = collectTags(await getPosts());
---

<Base title="태그" description="글을 가로지르는 태그." wide>
  <header>
    <p class="kicker">Blog</p>
    <h1 class="page-title">태그</h1>
  </header>
  <ul class="taxonomy-list">
    {
      tags.map((tag) => (
        <li>
          <a href={url(`/tags/${tag.slug}/`)}>
            <span>{tag.name}</span>
            <span class="count">{tag.posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
